#!/usr/bin/env python3
"""Print live usage for every CLIProxyAPI account (claude, codex, xai).

Codex grants are checked against the live Codex usage endpoint. Claude and
xAI grants have no public usage endpoint, so they show grant state plus the
gateway-side cooldown/oauth-block state that CLIProxyAPI records in cpa.log.

Free-tier codex grants (id token claims chatgpt_plan_type=free) and disabled
grants stay out of the default view; --all shows everything.

    usage              all pooled paid accounts
    usage aryan        filter by email or filename substring
    usage --all        include free-tier and disabled grants
    usage --json       machine-readable state for every grant
    usage --check      exit 1 if any displayed grant is unusable
"""
from __future__ import annotations

import argparse
import base64
import json
import os
import re
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timedelta, timezone
from pathlib import Path

AUTH_DIR = Path.home() / ".cli-proxy-api"
GATEWAY_LOG = AUTH_DIR / "cpa.log"
LOG_TAIL_BYTES = 512 * 1024  # cooldown lines repeat on every failed selection; tail is plenty

USAGE_URL = "https://chatgpt.com/backend-api/wham/usage"
RESET_CREDITS_URL = "https://chatgpt.com/backend-api/wham/rate-limit-reset-credits"

GATEWAY_HOST = "127.0.0.1:8317"
KNOWN_CODEX_PLANS = {"plus", "pro", "prolite", "team", "free"}
GLOB_BY_PROVIDER = ("claude-*.json", "codex-*.json", "xai-*.json")
PROVIDER_ORDER = {"claude": 0, "codex": 1, "xai": 2}

COOLDOWN_RE = re.compile(
    r"auth_file=(?P<file>[^,\s]+\.json),\s*reason=(?P<reason>\w+),\s*remaining=(?P<remaining>[\dhms]+)"
)
AUTH_FILE_RE = re.compile(r"auth_file=([^,\s]+\.json)")
ERROR_CODE_RE = re.compile(r'"error_code"\s*:\s*"([\w-]+)"')
LOG_PREFIX_RE = re.compile(r"^\[(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})\]")


def color_enabled() -> bool:
    return sys.stdout.isatty() and not os.getenv("NO_COLOR")


def paint(text: str, code: str) -> str:
    if not color_enabled():
        return text
    return f"\033[{code}m{text}\033[0m"


def bar(percent: float, width: int = 20) -> str:
    filled = max(0, min(width, round(width * percent / 100)))
    body = "█" * filled + "░" * (width - filled)
    if percent >= 90:
        return paint(body, "31")
    if percent >= 70:
        return paint(body, "33")
    return paint(body, "32")


def percent_color(percent: float) -> str:
    text = f"{percent:5.1f}%"
    if percent >= 90:
        return paint(text, "31;1")
    if percent >= 70:
        return paint(text, "33")
    return paint(text, "32")


def parse_time(value: str | None) -> datetime | None:
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def local_when(value: str | int | datetime | None) -> str:
    if isinstance(value, datetime):
        parsed = value
    elif isinstance(value, int):
        parsed = datetime.fromtimestamp(value, timezone.utc)
    else:
        parsed = parse_time(value)
    if parsed is None:
        return str(value or "unknown")
    local = parsed.astimezone()
    seconds = int((parsed.astimezone(timezone.utc) - datetime.now(timezone.utc)).total_seconds())
    if seconds <= 0:
        relative = "expired"
    else:
        parts: list[str] = []
        for suffix, size in (("d", 86400), ("h", 3600), ("m", 60)):
            count, seconds = divmod(seconds, size)
            if count:
                parts.append(f"{count}{suffix}")
            if len(parts) == 2:
                break
        relative = "in " + " ".join(parts) if parts else "in <1m"
    return f"{local.strftime('%-d %b %H:%M %Z')} ({relative})"


def parse_duration_seconds(text: str | None) -> int | None:
    if not text:
        return None
    match = re.fullmatch(r"(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?", text.strip())
    if not match or not any(match.groups()):
        return None
    hours, minutes, seconds = (int(part or 0) for part in match.groups())
    return hours * 3600 + minutes * 60 + seconds


def load_gateway_state() -> dict[str, dict]:
    """Last cooldown/oauth-block state per auth file, from the cpa.log tail.

    Lines are chronological, so the latest event per file wins. Plain 429
    rate-limit failures are ignored: the gateway re-arms a quota cooldown for
    them, and the cooldown line carries the readable reset end.
    """
    events: dict[str, list[tuple[datetime, int, str, str]]] = {}
    if not GATEWAY_LOG.exists():
        return {}
    try:
        with GATEWAY_LOG.open("rb") as handle:
            handle.seek(0, os.SEEK_END)
            size = handle.tell()
            handle.seek(max(0, size - LOG_TAIL_BYTES))
            tail = handle.read().decode(errors="replace")
    except OSError:
        return {}
    for index, line in enumerate(tail.splitlines()):
        stamp = LOG_PREFIX_RE.match(line)
        when = datetime.strptime(stamp.group(1), "%Y-%m-%d %H:%M:%S") if stamp else datetime.min
        for match in COOLDOWN_RE.finditer(line):
            events.setdefault(match.group("file"), []).append(
                (when, index, "cooldown", match.group("remaining"))
            )
        if "upstream execution failed" in line and "permission_error" in line:
            file_match = AUTH_FILE_RE.search(line)
            if file_match:
                code = ERROR_CODE_RE.search(line)
                events.setdefault(file_match.group(1), []).append(
                    (when, index, "oauth", code.group(1) if code else "oauth")
                )
    state: dict[str, dict] = {}
    for file, file_events in events.items():
        when, _, kind, payload = max(file_events, key=lambda event: (event[0], event[1]))
        if kind == "cooldown":
            seconds = parse_duration_seconds(payload)
            if seconds is None:
                continue
            state[file] = {"cooldown_end": (when + timedelta(seconds=seconds)).astimezone()}
        else:
            state[file] = {"blocked": payload}
    return state


def decode_jwt_payload(token: str) -> dict:
    try:
        payload = token.split(".")[1]
        payload += "=" * (-len(payload) % 4)
        return json.loads(base64.urlsafe_b64decode(payload))
    except Exception:
        return {}


def claim_plan(codex_data: dict) -> str | None:
    claim = decode_jwt_payload(codex_data.get("id_token") or "")
    auth = claim.get("https://api.openai.com/auth") or {}
    if isinstance(auth, dict):
        return auth.get("chatgpt_plan_type")
    return None


def suffix_plan(path: Path) -> str | None:
    segment = path.stem.rsplit("-", 1)[-1]
    return segment if segment in KNOWN_CODEX_PLANS else None


def fetch_json(url: str, token: str, account_id: str) -> tuple[int, dict | None, str | None]:
    result = subprocess.run(
        [
            "curl",
            "-sS",
            "--max-time",
            "20",
            "-w",
            "\n%{http_code}",
            "-H",
            f"Authorization: Bearer {token}",
            "-H",
            f"ChatGPT-Account-Id: {account_id}",
            "-H",
            "Accept: application/json",
            "-H",
            "User-Agent: codex_cli_rs/0.147.0",
            "-H",
            "originator: codex_cli_rs",
            url,
        ],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return 0, None, result.stderr.strip() or "curl failed"
    body, _, status_text = result.stdout.rpartition("\n")
    try:
        status = int(status_text)
    except ValueError:
        return 0, None, "invalid HTTP response"
    try:
        payload = json.loads(body) if body else {}
    except json.JSONDecodeError:
        return status, None, "endpoint returned non-JSON"
    return status, payload, None


def fetch_usage(account: dict) -> dict:
    token = account.pop("access_token", "")
    if not token:
        return {**account, "usage_status": 0, "error": "grant has no access token"}
    with ThreadPoolExecutor(max_workers=2) as pool:
        usage_future = pool.submit(fetch_json, USAGE_URL, token, account["account_id"])
        credits_future = pool.submit(fetch_json, RESET_CREDITS_URL, token, account["account_id"])
    usage_status, usage, usage_error = usage_future.result()
    credits_status, reset_credits, credits_error = credits_future.result()
    return {
        **account,
        "usage_status": usage_status,
        "usage": usage,
        "error": usage_error,
        "reset_credits_status": credits_status,
        "reset_credits": reset_credits,
        "reset_credits_error": credits_error,
    }


def load_accounts(needle: str | None) -> list[dict]:
    accounts: list[dict] = []
    for pattern in GLOB_BY_PROVIDER:
        for path in sorted(AUTH_DIR.glob(pattern)):
            try:
                data = json.loads(path.read_text())
            except (OSError, json.JSONDecodeError) as exc:
                print(f"{path.name}: unreadable ({exc})", file=sys.stderr)
                continue
            email = data.get("email") or path.stem
            if needle and needle.lower() not in email.lower() and needle.lower() not in path.name.lower():
                continue
            expiry = parse_time(data.get("expired"))
            account = {
                "file": path.name,
                "provider": data.get("type") or path.stem.split("-", 1)[0],
                "email": email,
                "disabled": bool(data.get("disabled")),
                "expired": bool(expiry and expiry.astimezone(timezone.utc) <= datetime.now(timezone.utc)),
                "expires": data.get("expired"),
                "last_refresh": data.get("last_refresh"),
            }
            if account["provider"] == "codex":
                account["plan"] = suffix_plan(path) or claim_plan(data)
                account["claim_plan"] = claim_plan(data)
                account["account_id"] = data.get("account_id")
                account["access_token"] = data.get("access_token")
            elif account["provider"] == "claude":
                account["organization_name"] = data.get("organization_name")
            elif account["provider"] == "xai":
                account["auth_kind"] = data.get("auth_kind")
            accounts.append(account)
    return accounts


def is_free_tier(account: dict) -> bool:
    return account["provider"] == "codex" and "free" in {account.get("plan"), account.get("claim_plan")}


def hide_reason(account: dict) -> str | None:
    if account["disabled"]:
        return "removed from pool"
    if is_free_tier(account):
        return "free tier"
    return None


def print_window(label: str, window: dict | None) -> None:
    if not window or window.get("used_percent") is None:
        print(f"    {label:<10}  {paint('-', '2')}")
        return
    percent = float(window["used_percent"])
    print(
        f"    {label:<10}  {bar(percent)} {percent_color(percent)}  "
        f"resets {local_when(window.get('reset_at'))}"
    )


def gateway_line(account: dict, gateway_state: dict) -> str:
    """Cooldown/block status for providers without a public usage endpoint."""
    if account["disabled"]:
        return paint("removed from pool (grant disabled)", "2")
    event = gateway_state.get(account["file"]) or {}
    if "blocked" in event:
        return paint(f"blocked upstream, oauth {event['blocked']}", "31")
    if "cooldown_end" in event:
        cooldown_end = event["cooldown_end"]
        if cooldown_end > datetime.now(timezone.utc):
            return paint(f"quota cooldown, resets {local_when(cooldown_end)}", "33")
        return paint("ready (no active cooldown)", "32")
    return paint("ready", "32")


def print_accounts(accounts: list[dict], gateway_state: dict) -> None:
    print(paint(f"Pooled accounts (CLIProxyAPI, {GATEWAY_HOST})", "1"))
    for account in sorted(accounts, key=lambda a: (PROVIDER_ORDER.get(a["provider"], 9), a["email"])):
        reason = hide_reason(account)
        flags: list[str] = []
        if account["expired"]:
            flags.append(paint("expired", "31"))
        if account["disabled"] and not reason:
            flags.append(paint("disabled", "31"))
        flags_text = f"  {' '.join(flags)}" if flags else ""
        reason_text = f"  {paint(reason, '2')}" if reason else ""
        plan_text = (
            f"  {paint(account.get('plan') or '-', '2')}" if account["provider"] == "codex" else ""
        )
        print(f"  {paint(account['provider'], '2')}  {paint(account['email'], '1')}{plan_text}{flags_text}{reason_text}")
        if account["provider"] == "codex":
            if account.get("usage_status") != 200:
                print(paint(f"    usage fetch failed ({account.get('usage_status')}): {account.get('error')}", "31"))
                continue
            rate_limit = (account.get("usage") or {}).get("rate_limit") or {}
            print_window("5-hour", rate_limit.get("primary_window"))
            print_window("weekly", rate_limit.get("secondary_window"))
            reset_credits = account.get("reset_credits") or {}
            if account.get("reset_credits_status") == 200:
                available = int(reset_credits.get("available_count") or 0)
                print(f"    {'free resets':<10}  {paint(str(available), '32;1' if available else '2')} available")
                for credit in reset_credits.get("credits") or []:
                    if credit.get("status") != "available":
                        continue
                    title = credit.get("title") or "Rate-limit reset"
                    print(f"      {title}, expires {local_when(credit.get('expires_at'))}")
            else:
                print(paint(f"    free resets  unavailable ({account.get('reset_credits_status')})", "31"))
            if rate_limit.get("limit_reached") or not rate_limit.get("allowed", True):
                print(paint("    blocked by current usage limit", "31"))
            continue
        if reason:
            continue
        line = gateway_line(account, gateway_state)
        if account["provider"] == "xai":
            expiry = parse_time(account.get("expires"))
            if expiry:
                line += paint(f", token {local_when(expiry)}", "2")
        print(f"    {line}")


def is_blocked(account: dict, gateway_state: dict) -> bool:
    if account["disabled"] or account["expired"]:
        return True
    if account["provider"] in ("claude", "xai"):
        event = gateway_state.get(account["file"]) or {}
        if "blocked" in event:
            return True
        cooldown_end = event.get("cooldown_end")
        return bool(cooldown_end and cooldown_end > datetime.now(timezone.utc))
    if account.get("usage_status") != 200:
        return True
    rate_limit = (account.get("usage") or {}).get("rate_limit") or {}
    return bool(rate_limit.get("limit_reached") or not rate_limit.get("allowed", True))


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="usage",
        description="Check live usage for CLIProxyAPI grants (claude, codex, xai).",
    )
    parser.add_argument("filter", nargs="?", help="substring of the account email or grant filename")
    parser.add_argument("--all", action="store_true", help="include free-tier and disabled grants")
    parser.add_argument("--json", action="store_true", help="print machine-readable state for every grant")
    parser.add_argument(
        "--check",
        action="store_true",
        help="exit 1 if any displayed grant is disabled, expired, blocked or in cooldown",
    )
    args = parser.parse_args()

    if not AUTH_DIR.is_dir():
        print(f"no auth dir at {AUTH_DIR}", file=sys.stderr)
        return 1

    grants = load_accounts(args.filter)
    if not grants:
        what = f" matching {args.filter!r}" if args.filter else ""
        print(f"no grants{what} in {AUTH_DIR}", file=sys.stderr)
        return 1

    gateway_state = load_gateway_state()
    # --json includes everything; a filter search reveals hidden rows; --all lifts the default view.
    show_everything = args.all or args.json or bool(args.filter)
    shown = [a for a in grants if show_everything or not hide_reason(a)]
    hidden = [a for a in grants if a not in shown]

    fetch_titles = grants if args.json else shown
    codex_rows = [a for a in fetch_titles if a["provider"] == "codex"]
    if codex_rows:
        with ThreadPoolExecutor(max_workers=len(codex_rows)) as pool:
            fetched = list(pool.map(fetch_usage, codex_rows))
        by_file = {a["file"]: a for a in fetched}
        grants = [by_file.get(a["file"], a) for a in grants]
        shown = [by_file.get(a["file"], a) for a in shown]

    if args.json:
        payload = []
        for account in grants:
            entry = {k: v for k, v in account.items() if k != "access_token"}
            entry["hidden_by"] = hide_reason(account)
            slot = gateway_state.get(account["file"]) or {}
            if account["provider"] != "codex" and slot:
                entry["gateway"] = {
                    key: value.isoformat() if isinstance(value, datetime) else value
                    for key, value in slot.items()
                }
            payload.append(entry)
        print(json.dumps({"accounts": payload, "gateway_log": str(GATEWAY_LOG)}, indent=2))
        if args.check:
            return 1 if any(is_blocked(a, gateway_state) for a in grants) else 0
        return 0

    print_accounts(shown, gateway_state)

    if not args.all and not args.filter and hidden:
        counts: dict[str, int] = {}
        for account in hidden:
            reason = hide_reason(account) or "hidden"
            counts[reason] = counts.get(reason, 0) + 1
        summary = ", ".join(f"{count} {reason}" for reason, count in sorted(counts.items()))
        print(paint(f"  ({len(hidden)} hidden: {summary}; usage --all to show)", "2"))

    if args.check and (not shown or any(is_blocked(a, gateway_state) for a in shown)):
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
