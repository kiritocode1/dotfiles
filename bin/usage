#!/usr/bin/env bash
# usage: CLIProxyAPI account state (claude, codex, xai grants).
# Launcher for tools/usage (bun + OpenTUI). Installs its packages on first run,
# or again after a cleanup deletes node_modules. `usage -h` lists the options.
set -euo pipefail

here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
app="$(cd "$here/../tools/usage" && pwd)"
bun="$(command -v bun || echo "$HOME/.bun/bin/bun")"

if [[ ! -d "$app/node_modules/@opentui/core" ]]; then
  echo "usage: installing packages in $app" >&2
  "$bun" install --cwd "$app" --frozen-lockfile --silent >&2
fi

exec "$bun" "$app/src/main.ts" "$@"
