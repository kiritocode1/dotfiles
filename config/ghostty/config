

# The syntax is "key = value". The whitespace around the
# equals doesn't matter.
# Blank Moonlight theme
background = #000000
foreground = #868690

# cursor
cursor-color = #c58fff

# selection
selection-background = #817c9c
selection-foreground = #fdfdfe

# ANSI colors
palette = 0=#131317
palette = 1=#f58ee0
palette = 2=#8eb6f5
palette = 3=#9898a6
palette = 4=#c58fff
palette = 5=#fdfdfe
palette = 6=#ffbb88
palette = 7=#868690
palette = 8=#575861
palette = 9=#f58ee0
palette = 10=#8eb6f5
palette = 11=#9898a6
palette = 12=#c58fff
palette = 13=#fdfdfe
palette = 14=#ffbb88
palette = 15=#868690

# Comments start with a `#` and are only valid on their own line.
# Blank lines are ignored!

keybind = ctrl+z=close_surface
keybind = ctrl+d=new_split:right
