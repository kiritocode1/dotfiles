{
  "lastChangelogVersion": "1.4.0",
  "theme": "dark",
  "packages": [
    "npm:@plannotator/pi-extension",
    "npm:pi-subagents",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:@mjasnikovs/pi-task",
    "git:github.com/acoyfellow/odds"
  ],
  "defaultProvider": "codex-pool",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "codex-pool/*"
  ],
  "steeringMode": "all",
  "followUpMode": "all",
  "defaultProjectTrust": "always",
  "extensions": [
    "-builtin:mcp"
  ]
}